# .dockerignore - exclude files from Docker build context

# Version control
.git/
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
.claude/
.trae/
.kiro/
.superpowers/
*.iml
*.ipr
*.iws

# Worktrees
.worktrees/

# Backend build artifacts
backend/target/
backend/*.log
backend/data/
backend/.m2/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Private docs
docs/private/
docs/superpowers/

# Runtime data
/data/
server.pid
server.log

# Environment configs
.env
.env.local
.env.*.local

# Nginx runtime config
nginx/nginx.conf
nginx/ssl/

# Project meta
CLAUDE.md
GEMINI.md
AGENTS.md
